SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=1
ALLOWED_EMAIL_DOMAIN=vit.edu.in

# Ground station (Mumbai default)
GS_LAT=19.08
GS_LON=72.88
GS_ELEVATION_M=14

# Weather location (Mumbai default)
WEATHER_LAT=19.08
WEATHER_LON=72.88
WEATHER_CACHE_TTL=600

# TLE cache (seconds)
TLE_CACHE_TTL=21600

# Local SQLite (default if unset):
# DATABASE_URL=sqlite:///instance/vidyajyoti.db
# Render PostgreSQL (set automatically on Render):
# DATABASE_URL=postgresql://user:pass@host/dbname
