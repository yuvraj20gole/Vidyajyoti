SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=1
ALLOWED_EMAIL_DOMAIN=vit.edu.in

# Email OTP via Gmail SMTP (registration)
# Local testing: set MAIL_DEV_MODE=1 (OTP printed in server logs)
MAIL_DEV_MODE=1

# Production (Render): Gmail app password required (Google Account -> Security -> App passwords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-college-gmail@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# MAIL_FROM=Vidyajyoti <your-college-gmail@gmail.com>
# MAIL_DEV_MODE=0
# OTP_EXPIRY_MINUTES=10

# Local SQLite (default if unset):
# DATABASE_URL=sqlite:///instance/vidyajyoti.db
# Render PostgreSQL (set automatically on Render):
# DATABASE_URL=postgresql://user:pass@host/dbname
