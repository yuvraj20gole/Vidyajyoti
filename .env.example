SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=1
ALLOWED_EMAIL_DOMAIN=vit.edu.in

# Email OTP (registration)
# Local: leave RESEND_API_KEY empty and set MAIL_DEV_MODE=1 (OTP printed in server logs)
MAIL_DEV_MODE=1
# Production (Render): get API key from https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Vidyajyoti <onboarding@resend.dev>
# OTP_EXPIRY_MINUTES=10

# Local SQLite (default if unset):
# DATABASE_URL=sqlite:///instance/vidyajyoti.db
# Render PostgreSQL (set automatically on Render):
# DATABASE_URL=postgresql://user:pass@host/dbname
